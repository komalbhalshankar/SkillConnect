@startuml SkillConnect_UseCase_Diagram
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #0284C7
skinparam usecaseFontName Arial
skinparam usecaseFontSize 12
skinparam arrowColor #334155
skinparam arrowFontColor #0284C7
skinparam arrowFontSize 10
skinparam actorBorderColor #1E293B
skinparam actorBackgroundColor #E2E8F0

left to right direction

' ==========================================
' ACTORS DEFINITION
' ==========================================
actor "Student" as student <<Primary Actor>>
actor "Administrator" as admin <<Secondary Actor>>

' ==========================================
' SYSTEM BOUNDARY
' ==========================================
rectangle "SkillConnect — Student Skill Exchange Platform" as SystemBoundary {

  ' --- Module 1: User Authentication & Profile ---
  usecase "Register Account" as UC_Register
  usecase "Log In / Log Out" as UC_Login
  usecase "View & Update Profile" as UC_Profile

  ' --- Module 2: Skill Management ---
  usecase "Manage Skills (Add, Edit, Remove)" as UC_ManageSkills
  usecase "Specify Skill Type & Proficiency" as UC_SkillTypeProf

  ' --- Module 3: Skill Discovery & Matching ---
  usecase "Search & Filter Students" as UC_Search
  usecase "View Student Profile" as UC_ViewProfile
  usecase "Discover Compatible Partners" as UC_Discover
  usecase "Calculate Compatibility Score & Matched Skills" as UC_CalculateScore

  ' --- Module 4: Skill Exchange & Session Management ---
  usecase "Send Exchange Request" as UC_SendRequest
  usecase "Respond to Request (Accept / Reject)" as UC_RespondRequest
  usecase "View Exchange History" as UC_History
  usecase "Schedule Learning Session" as UC_Schedule
  usecase "View Session Details" as UC_SessionDetails
  usecase "Complete or Cancel Session" as UC_CompleteSession

  ' --- Module 5: Rating, Feedback & Dashboard ---
  usecase "Rate Completed Exchange" as UC_Rate
  usecase "Submit Written Feedback" as UC_Feedback
  usecase "View Dashboard & Activity Summaries" as UC_Dashboard

  ' --- Administration ---
  usecase "Log In as Administrator" as UC_AdminLogin
  usecase "Access Protected Admin Portal" as UC_AdminPortal
  usecase "View Platform Statistics" as UC_AdminStats
  usecase "Manage Skill Categories & Skills" as UC_ManageTaxonomy
}

' ==========================================
' STUDENT ASSOCIATIONS
' ==========================================
student --> UC_Register
student --> UC_Login
student --> UC_Profile
student --> UC_ManageSkills
student --> UC_Search
student --> UC_ViewProfile
student --> UC_Discover
student --> UC_SendRequest
student --> UC_RespondRequest
student --> UC_History
student --> UC_Schedule
student --> UC_SessionDetails
student --> UC_CompleteSession
student --> UC_Rate
student --> UC_Dashboard

' ==========================================
' INCLUDE & EXTEND RELATIONSHIPS
' ==========================================
UC_ManageSkills ..> UC_SkillTypeProf : <<include>>
UC_Discover ..> UC_CalculateScore : <<include>>
UC_Rate ..> UC_Feedback : <<include>>
UC_Schedule ..> UC_RespondRequest : <<extend>>
UC_Rate ..> UC_CompleteSession : <<extend>>

' ==========================================
' ADMINISTRATOR ASSOCIATIONS
' ==========================================
admin --> UC_AdminLogin
admin --> UC_AdminPortal
admin --> UC_AdminStats
admin --> UC_ManageTaxonomy

UC_AdminPortal ..> UC_AdminLogin : <<include>>
UC_AdminStats ..> UC_AdminPortal : <<include>>
UC_ManageTaxonomy ..> UC_AdminPortal : <<include>>

@enduml
